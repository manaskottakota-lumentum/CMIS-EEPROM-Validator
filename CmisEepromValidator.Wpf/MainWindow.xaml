<Window x:Class="CmisEepromValidator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CVSA CMIS EEPROM Validator v1.0.0"
        Width="1600"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Background="{StaticResource PageBrush}">
    <Window.Resources>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TrimmedCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <Grid Margin="24,36,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Grid Width="24"
                          Height="24"
                          Margin="0,0,8,0">
                        <Border Width="3"
                                Height="18"
                                Background="#12B76A"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="35" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="3"
                                Height="9"
                                Background="#EF4444"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8,1,0,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="35" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="3"
                                Height="9"
                                Background="#2563EB"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="35" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Text="LUMENTUM"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,36,0,0"
                        Background="#F0F2F5"
                        CornerRadius="4"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#05080D"
                                CornerRadius="2"
                                Margin="0,8,0,8" />
                        <Ellipse Width="10"
                                 Height="10"
                                 Stroke="{StaticResource InkBrush}"
                                 StrokeThickness="1.5"
                                 VerticalAlignment="Center"
                                 Grid.Column="1"
                                 Margin="14,0,0,0" />
                        <TextBlock Grid.Column="2"
                                   Text="Validate"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="20,12,0,12" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12"
                                 Height="12"
                                 Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FooterStatus}"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ValidationTime}"
                               Style="{StaticResource MutedText}"
                               Margin="22,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="0"
              Margin="28,28,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Validate EEPROM"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Load a CMIS EEPROM hex dump and an expected-values file to validate programmed parameters."
                               Style="{StaticResource MutedText}"
                               Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Content="Export Results"
                            Command="{Binding ExportResultsCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="..."
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="16,6,0,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="EEPROM / CMIS Hex Dump"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="File"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding DumpFileName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="360" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DumpFileSize}"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{Binding DumpLoadedBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DumpLoadedText}"
                                           Margin="8,0,0,0"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,18,0,0">
                            <Button Content="Replace File"
                                    Command="{Binding BrowseDumpCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="View Info"
                                    Command="{Binding ViewDumpInfoCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Expected Values (Excel)"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="File"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding WorkbookFileName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="360" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding WorkbookFileSize}"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{Binding WorkbookLoadedBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WorkbookLoadedText}"
                                           Margin="8,0,0,0"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,18,0,0">
                            <Button Content="Replace File"
                                    Command="{Binding BrowseWorkbookCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="View Info"
                                    Command="{Binding ViewWorkbookInfoCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,20,0,0">
                <Button Content="Run Validation"
                        Command="{Binding RunValidationCommand}"
                        Style="{StaticResource PrimaryButton}" />
                <Button Content="Load Samples"
                        Command="{Binding LoadSamplesCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="12,0,0,0" />
                <Button Content="Clear"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="12,0,0,0" />
                <CheckBox Content="Show all rows"
                          IsChecked="{Binding ShowAllRows}"
                          VerticalAlignment="Center"
                          Margin="20,0,0,0" />
            </StackPanel>

            <Border Grid.Row="3"
                    Style="{StaticResource Card}"
                    Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="{Binding SummaryIconBackground}">
                            <TextBlock Text="{Binding SummaryIconText}"
                                       Foreground="{Binding SummaryIconBrush}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverallText}"
                                       Foreground="{Binding OverallBrush}"
                                       FontSize="26"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding OverallMessage}"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="230" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total"
                                   Style="{StaticResource TinyLabel}" />
                        <TextBlock Text="{Binding Total}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Passed"
                                   Style="{StaticResource TinyLabel}" />
                        <TextBlock Text="{Binding Passed}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Failed"
                                   Style="{StaticResource TinyLabel}" />
                        <TextBlock Text="{Binding Failed}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Not Checked"
                                   Style="{StaticResource TinyLabel}" />
                        <TextBlock Text="{Binding NotChecked}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Errors"
                                   Style="{StaticResource TinyLabel}" />
                        <TextBlock Text="{Binding Errors}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Validation Time"
                                   Style="{StaticResource TinyLabel}" />
                        <TextBlock Text="{Binding ValidationTime}"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding DurationText}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Validation Results"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <Grid Grid.Row="1"
                              Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}" />
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding ResultsView}"
                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  MinColumnWidth="70">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sheet"
                                                    Binding="{Binding SourceSheet}"
                                                    Width="75"
                                                    ElementStyle="{StaticResource TrimmedCellText}" />
                                <DataGridTextColumn Header="Check"
                                                    Binding="{Binding Check}"
                                                    Width="62"
                                                    ElementStyle="{StaticResource TrimmedCellText}" />
                                <DataGridTextColumn Header="Parameter"
                                                    Binding="{Binding Parameter}"
                                                    Width="260"
                                                    ElementStyle="{StaticResource TrimmedCellText}" />
                                <DataGridTextColumn Header="Page / Address"
                                                    Binding="{Binding PageAddress}"
                                                    Width="125"
                                                    ElementStyle="{StaticResource TrimmedCellText}" />
                                <DataGridTextColumn Header="Data Type"
                                                    Binding="{Binding DataType}"
                                                    Width="150"
                                                    ElementStyle="{StaticResource TrimmedCellText}" />
                                <DataGridTextColumn Header="Expected / Prior"
                                                    Binding="{Binding Expected}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource TrimmedCellText}" />
                                <DataGridTextColumn Header="Module Value"
                                                    Binding="{Binding Actual}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource TrimmedCellText}" />
                                <DataGridTemplateColumn Header="Status"
                                                        Width="116">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontWeight="SemiBold"
                                                       Padding="4,0"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding FooterStatus}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,12,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource Card}"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Parameter Details"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Grid.Column="1"
                                       Text="X"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,24,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedResult.Parameter, TargetNullValue=-, FallbackValue=-}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,12,0" />
                                    <Border Grid.Column="1"
                                            Background="#E8F7EF"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedResult.Status, TargetNullValue=-, FallbackValue=-}"
                                                   Foreground="{Binding SelectedResult.StatusBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Description" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Description, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Source Sheet" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.SourceSheet, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Check" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Check, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Page" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Page, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bank" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Bank, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Start Address" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Address, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Length" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.LengthText, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Data Type" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.DataType, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CMIS Type" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.CmisType, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Simple Type" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.SimpleType, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Expected Value" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Expected, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Module Value" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Actual, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Raw Data" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.RawHex, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                                <Border Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Significance" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Message, TargetNullValue=-, FallbackValue=-}" Style="{StaticResource DetailValue}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
